# Copy to backend/.env and set credentials for your PostgreSQL server.
DATABASE_URL=postgresql+psycopg://postgres:classsense-local-only@localhost:5432/classsense
# Set a private deployment signing key; development generates a local key automatically.
# JWT_SECRET=replace-with-a-long-random-secret
# BIOMETRIC_KEY_FILE=/private/persistent/path/biometric.key
# Render uses ENVIRONMENT=production and persistent environment secrets.
# SECRET_KEY=use-a-persistent-random-value-at-least-32-characters-long
# BIOMETRIC_KEY_BASE64=base64-of-the-existing-backend/.secrets/biometric.key
# CORS_ORIGINS=["https://your-project.vercel.app"]
# ONNX_THREADS=1
HIGH_CONFIDENCE_THRESHOLD=0.65
LOW_CONFIDENCE_THRESHOLD=0.45
MIN_IMAGE_APPEARANCES=2
