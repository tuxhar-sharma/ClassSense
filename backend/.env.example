# SQLite is the default; uncomment to use PostgreSQL.
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/classsense
# Set a private deployment signing key; development generates a local key automatically.
# JWT_SECRET=replace-with-a-long-random-secret
# BIOMETRIC_KEY_FILE=/private/persistent/path/biometric.key
HIGH_CONFIDENCE_THRESHOLD=0.65
LOW_CONFIDENCE_THRESHOLD=0.45
MIN_IMAGE_APPEARANCES=2
